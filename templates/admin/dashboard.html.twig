{% extends 'admin/layout.html.twig' %}

{% block title %}CMS professionnel - Bazma Kebili{% endblock %}
{% block html_lang %}fr{% endblock %}
{% block html_dir %}ltr{% endblock %}

{% block meta_robots %}noindex,nofollow{% endblock %}

{% block workspace %}

<main class="admin-layout admin-workspace">
    {% set successMessages = app.flashes('success') %}
    {% set errorMessages = app.flashes('error') %}
    {% if successMessages or errorMessages %}
        <div class="admin-flashes" role="status" aria-live="polite">
            {% for message in successMessages %}<p class="success admin-flash">{{ message }}</p>{% endfor %}
            {% for message in errorMessages %}<p class="alert admin-flash">{{ message }}</p>{% endfor %}
        </div>
    {% endif %}

    {% if currentSection == 'overview' %}
    <section class="admin-hero-panel">
        <div>
            <p class="admin-eyebrow">Centre de contrôle</p>
            <h1>Vue d’ensemble</h1>

        </div>
        <div class="admin-quick-actions" aria-label="Actions rapides">
            {% if is_granted('ROLE_HOME_MANAGER') %}<a class="button" href="{{ path('admin_home_settings') }}">Modifier l’accueil</a>{% endif %}
            {% if is_granted('ROLE_PAGE_MANAGER') %}<a class="button" href="{{ path('admin_page_new') }}">Nouvelle page</a>{% endif %}
            {% if is_granted('ROLE_MEDIA_MANAGER') %}<a class="button secondary-admin" href="{{ path('admin_image_new') }}">Ajouter une image</a>{% endif %}
            {% if is_granted('ROLE_NEWS_MANAGER') %}<a class="button secondary-admin" href="{{ path('admin_event_new') }}">Publier une actualité</a>{% endif %}
            {% if is_granted('ROLE_USER_MANAGER') %}<a class="button secondary-admin" href="{{ path('admin_users') }}">Gérer les modérateurs</a>{% endif %}
        </div>
    </section>

    {% endif %}
    {% if currentSection == 'approvals' %}
    <section class="admin-content-section" data-cms-list>
        <div class="admin-section-head">
            <div>
                <p class="admin-eyebrow">Validation</p>
                <h2>Publications à valider</h2>
            </div>
            {% if app.user and app.user.superAdmin %}
                <form method="post" action="{{ path('admin_approval_workflow_toggle') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_approval_workflow') }}">
                    <button class="button small {{ approvalWorkflowEnabled ? 'secondary-admin' : '' }}" type="submit" role="switch" aria-checked="{{ approvalWorkflowEnabled ? 'true' : 'false' }}" aria-label="Validation avant publication">{{ approvalWorkflowEnabled ? 'Validation activée' : 'Validation désactivée' }}</button>
                </form>
            {% endif %}
        </div>
        <p class="admin-empty">{{ approvalWorkflowEnabled ? 'Actif: les modifications des moderateurs sont envoyees en validation avant publication.' : 'Inactif: les modifications autorisees sont appliquees directement.' }}</p>

        {% if app.user and app.user.superAdmin %}
            {% include 'admin/list_tools.html.twig' %}
        <div class="admin-list">
                {% for approvalRequest in approvalRequests %}
                    <article class="admin-item">
                        <div class="admin-item-main">
                            <span class="status-pill is-draft">{{ approvalRequest.action }}</span>
                            <h3>{{ approvalRequest.entityLabel }}</h3>
                            <p>{{ approvalRequest.entityClass|split('\\\\')|last }} · demandé par {{ approvalRequest.requestedBy ? approvalRequest.requestedBy.name : 'Compte supprime' }} · {{ approvalRequest.createdAt|date('d/m/Y H:i') }}</p>
                        </div>
                        <div class="admin-item-actions">
                            <form method="post" action="{{ path('admin_approval_approve', {id: approvalRequest.id}) }}" onsubmit="return confirm('Approuver et publier cette demande ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('approve_request_' ~ approvalRequest.id) }}">
                                <button type="submit">Approuver</button>
                            </form>
                            <form method="post" action="{{ path('admin_approval_reject', {id: approvalRequest.id}) }}" onsubmit="return confirm('Rejeter cette demande ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('reject_request_' ~ approvalRequest.id) }}">
                                <button class="link-danger" type="submit">Rejeter</button>
                            </form>
                        </div>
                    </article>
                {% else %}
                    <p class="admin-empty">Aucune demande en attente.</p>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    {% endif %}
    {% if currentSection == 'overview' %}
    <section class="admin-kpis admin-kpis-pro" aria-label="Statistiques CMS">
        {% if is_granted('ROLE_PAGE_MANAGER') %}<a href="{{ path('admin_dashboard', {section: 'pages'}) }}"><strong>{{ pages|length }}</strong><span>Pages</span><img src="/assets/icons/arrow-up-right.svg" alt=""></a>{% endif %}
        {% if is_granted('ROLE_MEDIA_MANAGER') %}<a href="{{ path('admin_dashboard', {section: 'images'}) }}"><strong>{{ images|length }}</strong><span>Images</span><img src="/assets/icons/arrow-up-right.svg" alt=""></a>{% endif %}
        {% if is_granted('ROLE_ORGANIZATION_MANAGER') %}<a href="{{ path('admin_dashboard', {section: 'organizations'}) }}"><strong>{{ organizations|length }}</strong><span>Associations</span><img src="/assets/icons/arrow-up-right.svg" alt=""></a>{% endif %}
        {% if is_granted('ROLE_SOCIAL_MANAGER') %}<a href="{{ path('admin_dashboard', {section: 'social'}) }}"><strong>{{ socialLinks|length }}</strong><span>Liens sociaux</span><img src="/assets/icons/arrow-up-right.svg" alt=""></a>{% endif %}
        {% if is_granted('ROLE_NEWS_MANAGER') %}<a href="{{ path('admin_dashboard', {section: 'events'}) }}"><strong>{{ events|length }}</strong><span>Actualités</span><img src="/assets/icons/arrow-up-right.svg" alt=""></a>{% endif %}
        {% if is_granted('ROLE_USER_MANAGER') %}<a href="{{ path('admin_users') }}"><strong>{{ users|length }}</strong><span>Membres</span><img src="/assets/icons/arrow-up-right.svg" alt=""></a>{% endif %}
    </section>

    {% endif %}
    {% if currentSection == 'overview' %}
        {% if is_granted('ROLE_SUPER_ADMIN') %}<div class="cms-review-summary"><span><strong>{{ approvalRequests|length }}</strong> demande{{ approvalRequests|length == 1 ? '' : 's' }} en attente</span><a href="{{ path('admin_dashboard', {section: 'approvals'}) }}">Ouvrir les validations &rarr;</a></div>{% endif %}
        {% if is_granted('ROLE_NEWS_MANAGER') %}
        <section class="admin-content-section">
            <div class="admin-section-head"><h2>Actualités à la une</h2><a href="{{ path('admin_dashboard', {section: 'events'}) }}">Toutes les actualités &rarr;</a></div>
            <div class="admin-list">{% for event in events|filter(event => event.featured and not event.archived)|slice(0, 4) %}<article class="admin-item"><div class="admin-item-main"><span class="status-pill {{ event.published ? 'is-live' : 'is-draft' }}">{{ event.published ? 'Publié' : 'Brouillon' }}</span><h3>{{ event.title }}</h3><p>{{ event.category }}</p></div><div class="admin-item-actions"><a href="{{ path('admin_event_edit', {id: event.id}) }}">Modifier</a></div></article>{% else %}<p class="admin-empty">Aucune actualité à la une.</p>{% endfor %}</div>
        </section>
        {% endif %}
    {% endif %}
    {% if currentSection == 'pages' and is_granted('ROLE_PAGE_MANAGER') %}
    <section class="admin-content-section" id="pages" data-cms-list>
        <div class="admin-section-head">
            <div>
                <p class="admin-eyebrow">Architecture</p>
                <h2>Pages du village</h2>
            </div>
            <a class="button small" href="{{ path('admin_page_new') }}">Ajouter</a>
        </div>
        {% include 'admin/list_tools.html.twig' %}
        <div class="admin-list">
            {% for page in pages %}
                <article class="admin-item">
                    <div class="admin-item-main">
                        <span class="status-pill {{ page.systemPage ? 'is-live' : (page.published ? 'is-live' : 'is-draft') }}">{{ page.systemPage ? 'Page système' : (page.published ? 'Publié' : 'Brouillon') }}</span>
                        <h3>{{ page.title }}</h3>
                        <p>/{{ page.slug }} · ordre {{ page.position }}</p>
                    </div>
                    <div class="admin-item-actions">
                        <a href="{{ path('admin_page_edit', {id: page.id}) }}">Modifier</a>
                        {% if not page.systemPage and is_granted('ROLE_PAGE_DELETE') %}
                            <form method="post" action="{{ path('admin_page_delete', {id: page.id}) }}" onsubmit="return confirm('Supprimer cette page ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_page_' ~ page.id) }}">
                                <button class="link-danger" type="submit">Supprimer</button>
                            </form>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <p class="admin-empty">Aucune page pour le moment.</p>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if currentSection == 'images' and is_granted('ROLE_MEDIA_MANAGER') %}
    <section class="admin-content-section admin-gallery-manager" id="images" data-cms-list>
        <div class="admin-section-head">
            <div>
                <p class="admin-eyebrow">Médiathèque</p>
                <h2>Galerie photo</h2>
            </div>
            <a class="button small" href="{{ path('admin_image_new') }}">Ajouter une image</a>
        </div>

        <div class="admin-gallery-summary" aria-label="Statistiques de la galerie">
            <div>
                <strong>{{ images|length }}</strong>
                <span>Total images</span>
            </div>
            <div>
                <strong>{{ galleryStats.featured }}</strong>
                <span>Mises en avant</span>
            </div>
            <div>
                <strong>{{ galleryStats.local }}</strong>
                <span>Visibles sur le site</span>
            </div>
        </div>

        {% include 'admin/list_tools.html.twig' %}
        <div class="admin-gallery-grid">
            {% for image in images %}
                {% set imagePath = image.imageUrl ?: '' %}
                {% set isLocalImage = imagePath starts with '/uploads/' or imagePath starts with '/assets/' %}
                <article class="admin-gallery-card {{ image.featured ? 'is-featured' : '' }} {{ not isLocalImage ? 'needs-local-image' : '' }}">
                    <div class="admin-gallery-thumb">
                        {% if image.imageUrl %}
                            <img src="{{ image.imageUrl|webp_image }}" alt="">
                        {% else %}
                            <div class="admin-image-placeholder">Image à importer</div>
                        {% endif %}
                        <div class="admin-gallery-badges">
                            <span class="status-pill {{ image.featured ? 'is-live' : '' }}">{{ image.featured ? 'Mise en avant' : 'Galerie' }}</span>
                            <span class="admin-gallery-order">#{{ image.position }}</span>
                        </div>
                    </div>
                    <div class="admin-gallery-card-body">
                        <div class="admin-gallery-locales">
                            <span>FR</span>
                            {% if image.titleEn %}<span>EN</span>{% endif %}
                            {% if image.titleAr %}<span>AR</span>{% endif %}
                            <span class="{{ isLocalImage ? 'is-ok' : 'is-warning' }}">{{ isLocalImage ? 'Local' : 'Non visible sur le site' }}</span>
                        </div>
                        <h3>{{ image.title }}</h3>
                        <p class="admin-gallery-path">{{ image.imageUrl ?: 'Aucun fichier sélectionné' }}</p>
                        {% if image.credit %}
                            <p class="admin-gallery-credit">{{ image.credit }}</p>
                        {% endif %}
                        {% if image.sourceUrl %}
                            <p class="admin-gallery-source">Source CMS: {{ image.sourceUrl }}</p>
                        {% endif %}
                        <div class="admin-item-actions">
                            <a class="button small secondary-admin" href="{{ path('admin_image_edit', {id: image.id}) }}">Modifier</a>
                            {% if is_granted('ROLE_MEDIA_DELETE') %}
                            <form method="post" action="{{ path('admin_image_delete', {id: image.id}) }}" onsubmit="return confirm('Supprimer cette image ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_image_' ~ image.id) }}">
                                <button class="link-danger" type="submit">Supprimer</button>
                            </form>
                            {% endif %}
                        </div>
                    </div>
                </article>
            {% else %}
                <p class="admin-empty">Aucune image pour le moment.</p>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if currentSection == 'organizations' and is_granted('ROLE_ORGANIZATION_MANAGER') %}
    <section class="admin-content-section" id="organizations" data-cms-list>
        <div class="admin-section-head">
            <div>
                <p class="admin-eyebrow">Communauté</p>
                <h2>Associations et structures</h2>
            </div>
            <a class="button small" href="{{ path('admin_organization_new') }}">Ajouter</a>
        </div>
        {% include 'admin/list_tools.html.twig' %}
        <div class="admin-list">
            {% for organization in organizations %}
                <article class="admin-item">
                    <div class="admin-item-main">
                        <span class="status-pill {{ organization.active ? 'is-live' : 'is-draft' }}">{{ organization.active ? 'Visible' : 'Masqué' }}</span>
                        <h3>{{ organization.name }}</h3>
                        <p>{{ organization.type }} · ordre {{ organization.position }}</p>
                    </div>
                    <div class="admin-item-actions">
                        <a href="{{ path('admin_organization_edit', {id: organization.id}) }}">Modifier</a>
                        {% if is_granted('ROLE_ORGANIZATION_DELETE') %}
                        <form method="post" action="{{ path('admin_organization_delete', {id: organization.id}) }}" onsubmit="return confirm('Supprimer cette structure ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_organization_' ~ organization.id) }}">
                            <button class="link-danger" type="submit">Supprimer</button>
                        </form>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <p class="admin-empty">Aucune structure pour le moment.</p>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if currentSection == 'social' and is_granted('ROLE_SOCIAL_MANAGER') %}
    <section class="admin-content-section" id="social" data-cms-list>
        <div class="admin-section-head">
            <div>
                <p class="admin-eyebrow">Présence digitale</p>
                <h2>Réseaux sociaux</h2>
            </div>
            <a class="button small" href="{{ path('admin_social_new') }}">Ajouter</a>
        </div>
        {% include 'admin/list_tools.html.twig' %}
        <div class="admin-list">
            {% for link in socialLinks %}
                <article class="admin-item">
                    <div class="admin-item-main">
                        <span class="status-pill">{{ link.platform }} · {{ link.category }}</span>
                        <h3>{{ link.title }}</h3>
                        <p>{{ link.url }}</p>
                    </div>
                    <div class="admin-item-actions">
                        <a href="{{ path('admin_social_edit', {id: link.id}) }}">Modifier</a>
                        {% if is_granted('ROLE_SOCIAL_DELETE') %}
                        <form method="post" action="{{ path('admin_social_delete', {id: link.id}) }}" onsubmit="return confirm('Supprimer ce lien ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_social_' ~ link.id) }}">
                            <button class="link-danger" type="submit">Supprimer</button>
                        </form>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <p class="admin-empty">Aucun lien social pour le moment.</p>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {% if currentSection == 'events' and is_granted('ROLE_NEWS_MANAGER') %}
    <section class="admin-content-section" id="events" data-cms-list>
        <div class="admin-section-head">
            <div>
                <p class="admin-eyebrow">Éditorial</p>
                <h2>Actualités</h2>
            </div>
            <a class="button small" href="{{ path('admin_event_new') }}">Ajouter</a>
        </div>
        {% include 'admin/list_tools.html.twig' %}
        <div class="admin-list">
            {% for event in events %}
                <article class="admin-item">
                    <div class="admin-item-main">
                        <span class="status-pill {{ event.archived ? 'is-archived' : (event.published ? 'is-live' : 'is-draft') }}">{{ event.archived ? 'Archivé' : (event.published ? (event.featured ? 'À la une' : 'Publié') : 'Brouillon') }}</span>
                        <h3>{{ event.title }}</h3>
                        <p>{{ event.category }} · {{ event.eventDate ? event.eventDate|date('d/m/Y') : 'Sans date' }} · {{ event.location }}</p>
                    </div>
                    <div class="admin-item-actions">
                        <a href="{{ path('admin_event_edit', {id: event.id}) }}">Modifier</a>
                        {% if is_granted('ROLE_NEWS_DELETE') %}
                        <form method="post" action="{{ path('admin_event_delete', {id: event.id}) }}" onsubmit="return confirm('Supprimer cette actualité ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_event_' ~ event.id) }}">
                            <button class="link-danger" type="submit">Supprimer</button>
                        </form>
                        {% endif %}
                    </div>
                </article>
            {% else %}
                <p class="admin-empty">Aucune actualité pour le moment.</p>
            {% endfor %}
        </div>
    </section>
    {% endif %}
</main>
{% endblock %}
