{% extends 'base.html.twig' %}
{% block body_class %}village-site{% endblock %}
{% block fonts %}
    {% if locale == 'ar' %}
        <link rel="preload" href="{{ asset('assets/fonts/alexandria-arabic-wght-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    {% else %}{{ parent() }}{% endif %}
{% endblock %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/village.css') }}?v=2">
    {% if locale == 'ar' %}<link rel="stylesheet" href="{{ asset('assets/arabic.css') }}?v=1">{% endif %}
{% endblock %}
{% block javascripts %}<script src="{{ asset('assets/village.js') }}?v=1" defer></script>{% endblock %}
{% block body %}
<a class="skip-link" href="#main-content">{{ 'village.skip'|trans }}</a>
<header class="village-header">
    <a class="village-brand" href="{{ path('app_home', {_locale: locale}) }}" aria-label="{{ 'nav.home'|trans }}"><span class="brand-mark" aria-hidden="true">B.</span><span><strong>{{ locale == 'ar' ? 'بازمة' : 'Bazma' }}</strong><small>{{ 'village.location'|trans }}</small></span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="village-navigation" aria-label="{{ 'village.menu'|trans }}" title="{{ 'village.menu'|trans }}" hidden><span></span><span></span><span></span></button>
    <nav id="village-navigation" class="village-navigation" aria-label="{{ 'village.menu'|trans }}">
        <a href="{{ path('app_home', {_locale: locale}) }}#decouvrir">{{ 'nav.discover'|trans }}</a>
        <a href="{{ path('app_home', {_locale: locale}) }}#actualites">{{ 'nav.news'|trans }}</a>
        <a href="{{ path('app_gallery', {_locale: locale}) }}" {% if app.request.attributes.get('_route') == 'app_gallery' %}aria-current="page"{% endif %}>{{ 'nav.gallery'|trans }}</a>
        <a href="{{ path('app_home', {_locale: locale}) }}#associations">{{ 'nav.associations'|trans }}</a>
        <span class="village-languages" aria-label="{{ 'village.languages'|trans }}">
            {% set route = app.request.attributes.get('_route') %}{% set params = app.request.attributes.get('_route_params')|default({}) %}
            {% for language, label in {fr: 'FR', ar: 'العربية', en: 'EN'} %}<a href="{{ path(route, params|merge({_locale: language})) }}" lang="{{ language }}" dir="{{ language == 'ar' ? 'rtl' : 'ltr' }}" hreflang="{{ language }}" aria-label="{{ {fr: 'Français', ar: 'العربية', en: 'English'}[language] }}" {% if locale == language %}aria-current="true"{% endif %}>{{ label }}</a>{% endfor %}
        </span>
    </nav>
</header>
{% block content %}{% endblock %}
<footer class="village-footer">
    <div class="footer-intro"><a href="{{ path('app_home', {_locale: locale}) }}">{{ locale == 'ar' ? 'بازمة' : 'Bazma' }}<span>.</span></a><p>{{ settings is defined ? settings.value('footer_text_' ~ locale, 'village.footer'|trans) : 'village.footer'|trans }}</p></div>
    <div><h2>{{ 'nav.discover'|trans }}</h2><a href="{{ path('app_home', {_locale: locale}) }}#decouvrir">{{ 'village.village'|trans }}</a><a href="{{ path('app_gallery', {_locale: locale}) }}">{{ 'nav.gallery'|trans }}</a><a href="{{ path('app_home', {_locale: locale}) }}#actualites">{{ 'nav.news'|trans }}</a></div>
    <div><h2>{{ 'village.together'|trans }}</h2><a href="{{ path('app_home', {_locale: locale}) }}#associations">{{ 'nav.associations'|trans }}</a><a href="{{ path('app_home', {_locale: locale}) }}#reseaux">{{ 'nav.social'|trans }}</a><a href="{{ path('app_donation', {_locale: locale}) }}">{{ 'donation.title'|trans }}</a></div>
    <div class="footer-bottom"><span>&copy; <bdi>{{ 'now'|date('Y') }}</bdi> {{ locale == 'ar' ? 'بازمة' : 'Bazma' }} · {{ 'village.location'|trans }}</span><a href="#main-content">{{ 'village.top'|trans }} &uarr;</a></div>
</footer>
{% endblock %}
