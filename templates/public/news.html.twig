{% extends 'public/layout.html.twig' %}

{% block title %}{{ event.localizedTitle(locale) }} - {{ 'brand'|trans }}{% endblock %}
{% block meta_description %}{{ event.localizedExcerpt(locale) }}{% endblock %}
{% block canonical_url %}{{ url('app_news_show', {_locale: locale, slug: event.slug}) }}{% endblock %}
{% block alternate_links %}
    {% for language in ['ar', 'fr', 'en'] %}<link rel="alternate" hreflang="{{ language }}" href="{{ url('app_news_show', {_locale: language, slug: event.slug}) }}">{% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ url('app_news_show', {_locale: 'ar', slug: event.slug}) }}">
{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_image %}{{ absolute_url((event.imageUrl ?: '/assets/bazma-hero.webp')|webp_image|available_image) }}{% endblock %}
{% block structured_data %}
    <script type="application/ld+json">{{ {
        '@context': 'https://schema.org',
        '@type': 'NewsArticle',
        headline: event.localizedTitle(locale),
        description: event.localizedExcerpt(locale),
        image: block('og_image'),
        mainEntityOfPage: block('canonical_url'),
        datePublished: event.eventDate ? event.eventDate|date('c') : null,
        dateModified: event.eventDate ? event.eventDate|date('c') : null,
        inLanguage: locale,
        publisher: {
            '@type': 'Organization',
            name: 'Bazma Kebili'
        }
    }|filter(value => value is not null)|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
{% endblock %}

{% block content %}

<main id="main-content" class="article-page news-detail-page">
    {% if event.imageUrl %}
        <img class="article-hero" src="{{ event.imageUrl|webp_image|available_image }}" alt="{{ event.localizedTitle(locale) }}">
    {% endif %}
    <article class="article-body">
        <p class="eyebrow"><bdi>{{ event.category }}</bdi>{% if event.eventDate %} · <time datetime="{{ event.eventDate|date('Y-m-d') }}" dir="ltr">{{ event.eventDate|date('d/m/Y') }}</time>{% endif %}</p>
        <h1>{{ event.localizedTitle(locale) }}</h1>
        <p class="lead">{{ event.localizedExcerpt(locale) }}</p>
        <div class="rich-text">{{ event.localizedDescription(locale)|rich_content }}</div>
        {% if event.sourceUrl %}
            <p><a class="button" href="{{ event.sourceUrl }}" target="_blank" rel="noreferrer">{{ 'news.source'|trans }}</a></p>
        {% endif %}
    </article>
</main>
{% endblock %}
